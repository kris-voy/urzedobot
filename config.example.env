# =============================================================================
# bezkolejki.eu (uw.bezkolejki.eu/ouw) appointment-slot watcher configuration
# Copy this file to ".env" in the same directory and fill in your values.
# =============================================================================

# --- Telegram ---------------------------------------------------------------
# Bot token from @BotFather (see README.md for how to create it)
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Numeric chat id of the ONE person allowed to use this bot (see README.md
# for how to get it). All other chat ids are ignored.
TELEGRAM_CHAT_ID=123456789

# Browser User-Agent string sent by headless Chromium (and used to pass
# Cloudflare). Optional -- leave unset to use the built-in Chrome-on-Windows
# default. Override only if you need to match a different browser fingerprint.
# USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36

# --- Queues to watch ---------------------------------------------------------
# Comma-separated list of queue letters to poll. Valid values: A, B, C
# (mapped internally to operation ids 3213864 / 3219596 / 3219597)
QUEUES=A,B,C

# --- Behavior mode ------------------------------------------------------------
# notify_only      -> just send a Telegram message when a slot appears
# block             -> also call BlockSlot to hold the slot, then notify
# block_and_fill    -> block + fill the reservation form with FORM_* data below
MODE=block_and_fill

# If true, after filling the form the bot immediately calls ConfirmReservation
# without waiting for a Telegram button press. If false (default, recommended),
# the bot waits for you to press "Confirm" in Telegram (4 minute timeout).
AUTO_CONFIRM=false

# --- Polling schedule (times are local Europe/Warsaw time) -------------------
# During FAST_WINDOW, the bot polls every FAST_INTERVAL_SECONDS.
# Outside of it, it polls every SLOW_INTERVAL_SECONDS. All intervals get
# +/-20% random jitter to avoid hammering the server on a fixed cadence.
FAST_WINDOW=05:45-08:45
FAST_INTERVAL_SECONDS=30
SLOW_INTERVAL_SECONDS=300

# --- Captcha reliability -------------------------------------------------------
# Every /Slot/* API call needs a Google reCAPTCHA v3 token. Tokens minted
# in-page by an automated headless browser (especially from a datacenter/VPS
# IP) tend to get LOW reCAPTCHA v3 scores, which the server rejects with
# HTTP 400 ("Error while verify captcha") -- often unreliably, i.e. it may
# work sometimes and fail other times with no code change. A captcha-solving
# service (2Captcha) mints tokens that reliably score high, at a cost of
# roughly $1-3 per 1000 solves (each solve also takes up to ~120s if the
# in-page browser method is failing constantly, this is worth it).
#
# To get a key: sign up at https://2captcha.com, top up a few dollars of
# balance, and paste your API key below. Leave it empty to use the free
# in-page browser method only (fine to try first, especially on a
# residential/home IP; VPS/datacenter IPs will likely need 2captcha).

# auto (default) = use 2captcha if TWOCAPTCHA_API_KEY is set, else fall back
# to the in-page browser method. Set explicitly to "browser" or "2captcha"
# to force one or the other.
CAPTCHA_PROVIDER=auto

# Your 2captcha.com API key. Leave empty to disable 2captcha (CAPTCHA_PROVIDER
# then always resolves to "browser", even if set to "auto").
TWOCAPTCHA_API_KEY=

# Minimum reCAPTCHA v3 score (0.0-1.0, higher = more "human") requested from
# 2captcha. 0.3 is 2captcha's own default and usually enough; raise it if the
# server keeps rejecting even 2captcha-minted tokens.
CAPTCHA_MIN_SCORE=0.3

# Whether Playwright launches Chromium headless. Default true (recommended;
# matches the original behavior of this bot). On Linux, running HEADFUL
# (false) under a virtual display (e.g. `xvfb-run`) can sometimes improve
# reCAPTCHA scores for the in-page browser method, at the cost of needing
# xvfb installed/wrapped around the process. Not needed if you're using
# 2captcha, and not needed on Windows.
HEADLESS=true

# --- Reservation form data ----------------------------------------------------
# Any environment variable starting with FORM_ becomes a fuzzy-match candidate
# for the dynamic form fields returned by the site (GetPropertiesForSlot).
# The key name (minus the FORM_ prefix), with underscores turned into spaces,
# is compared (lowercased, diacritics stripped) against each field's label.
# Add / remove FORM_* keys freely -- unmatched keys are simply ignored, and
# unmatched form fields are simply left blank.
FORM_IMIE=Jane
FORM_NAZWISKO=Kowalska
FORM_EMAIL=example@example.com
FORM_TELEFON=+48123456789
FORM_NUMER_SPRAWY=
FORM_OBYWATELSTWO=Ukraina

# --- Observability (optional) -------------------------------------------------
# Error tracking via Sentry (https://sentry.io or a self-hosted/Grafana Cloud
# instance that speaks the Sentry protocol). Every logger.error(...) call the
# bot already makes becomes a Sentry event automatically -- no other code
# changes needed. Leave empty to disable entirely (default; zero cost, the
# sentry_sdk package is never even imported). See README "Observability".
SENTRY_DSN=
# Tag events with which deployment sent them (e.g. "proxmox", "dev-laptop")
# so a local test run doesn't get mixed in with the real deployment's alerts.
SENTRY_ENVIRONMENT=production
