# The only supported runtime mode.
MODE=notify_only
AUTO_CONFIRM=false
QUEUES=A,B,C

# Telegram alerts and admin commands (/status, /recheck, /stats).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_POLL_TIMEOUT_SECONDS=15
TELEGRAM_POLL_BACKOFF_SECONDS=3
TELEGRAM_RECHECK_WAIT_SECONDS=20

FAST_WINDOW=05:45-08:45
FAST_INTERVAL_SECONDS=30
SLOW_INTERVAL_SECONDS=300
JITTER_PERCENT=0.35
HEADLESS=true

# Identity of this vantage point. Alerts are prefixed with it so you can tell
# which node (LXC, Raspberry Pi, ...) saw an event.
NODE_NAME=
# Delay the first cycle so two nodes interleave instead of polling in lockstep.
# Set this to roughly half the poll interval on the second node.
SCHEDULE_OFFSET_SECONDS=0
# Seconds between queue A/B/C checks inside a cycle.
QUEUE_STAGGER_SECONDS=5

# CAPTCHA backoff. While the site refuses passive tokens the poll interval is
# doubled per blocked cycle up to this ceiling, then polling pauses entirely.
CAPTCHA_BACKOFF_MAX_SECONDS=1800
CAPTCHA_COOLDOWN_FAILURES=10
CAPTCHA_COOLDOWN_SECONDS=2700

# Optional paid hCaptcha solver, used only when passive minting is refused.
# none | capsolver | 2captcha
CAPTCHA_SOLVER_PROVIDER=none
CAPTCHA_SOLVER_API_KEY=
CAPTCHA_SOLVER_TIMEOUT_SECONDS=120
CAPTCHA_SOLVER_MAX_PER_HOUR=60

DATABASE_PATH=/app/data/sv.db
INCIDENT_THRESHOLD=3
HEARTBEAT_STALE_SECONDS=90
CATALOG_STALE_SECONDS=86400
OPERATION_STALE_SECONDS=900
# Hour (0-23, Europe/Warsaw) for the once-daily summary message.
DAILY_DIGEST_HOUR=21
