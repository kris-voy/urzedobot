# =============================================================================
# APPLICANT personal data — used ONLY when MODE=block_and_fill (auto-fill).
# Copy this file to "applicant.env" and fill it in, OR run the guided wizard:
#     python3.14 setup_applicant.py
#
# This file is kept SEPARATE from .env on purpose: .env holds operational
# settings (tokens, timing), this holds one person's personal data.
#
# IMPORTANT: we do not yet know the EXACT set of fields the pickup form asks
# for (the site only reveals them once a real slot is blocked). So fill in
# everything you can below. Each FORM_* key is fuzzy-matched (lowercased,
# diacritics stripped, underscores -> spaces) against the site's field labels;
# keys that don't match any field are simply ignored, and any form field we
# have no value for is left blank for you to complete manually from the
# Telegram link. The first real grab will log the site's exact field names so
# we can tighten this list.
# =============================================================================

# Core identity
FORM_IMIE=
FORM_NAZWISKO=
FORM_DATA_URODZENIA=
FORM_OBYWATELSTWO=

# Contact (email is required — the site sends a confirmation link there)
FORM_EMAIL=
FORM_TELEFON=

# Case / document identifiers (fill whichever apply to her case)
FORM_NUMER_SPRAWY=
FORM_PESEL=
FORM_NUMER_DOKUMENTU=
FORM_NUMER_PASZPORTU=
